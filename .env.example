# Required: create your own Anthropic API key at https://console.anthropic.com/
# Leave blank until you add a real key.
ANTHROPIC_API_KEY=

# Optional. Default model from the requested specification.
MODEL=claude-sonnet-5-5

# Optional. Leave blank to disable HTTP Basic Auth.
APP_PASSWORD=

# Optional. Requests allowed per IP per rolling hour.
RATE_LIMIT_PER_HOUR=40

# Optional local server port. Railway provides PORT automatically.
PORT=3000
